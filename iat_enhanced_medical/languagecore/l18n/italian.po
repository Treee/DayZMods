msgctxt "IAT_EM_ACTION_EXTRACT_BULLET_SELF"
msgid "Extract bullet"
msgstr "Estrarre proiettile"

msgctxt "IAT_EM_ACTION_EXTRACT_BULLET_TARGET"
msgid "Extract person's bullet"
msgstr "Estrarre proiettile a un'altra persona"

msgctxt "IAT_EM_ACTION_REMOVE_BANDAGE_SELF"
msgid "Cut off bandage"
msgstr "Tagliare benda"

msgctxt "IAT_EM_ACTION_REMOVE_BANDAGE_TARGET"
msgid "Cut off person's bandage"
msgstr "Tagliare la benda di un'altra persona"

msgctxt "IAT_EM_REMOVE_INCOMPATIBLE_DRESSING"
msgid "Remove the damaged or incompatible dressing before applying a new one."
msgstr "Rimuovi la medicazione danneggiata o non adatta prima di applicarne una nuova."

msgctxt "IAT_EM_DRESSING_ATTACHMENT_FAILED"
msgid "The dressing could not be attached."
msgstr "Non è stato possibile applicare la medicazione."

msgctxt "IAT_EM_BANDAGE_REMOVED"
msgid "Cut off a bandage."
msgstr "Una benda è stata tagliata."

msgctxt "IAT_EM_PATIENT_BANDAGE_REMOVED"
msgid "Your bandage was cut off."
msgstr "La tua benda è stata tagliata."

msgctxt "IAT_EM_NO_RETAINED_BULLET"
msgid "No retained bullet was found."
msgstr "Non è stato trovato alcun proiettile ritenuto."

msgctxt "IAT_EM_BULLET_REMOVED_Head"
msgid "Removed a retained bullet from head."
msgstr "Rimosso un proiettile ritenuto dalla testa."

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_Head"
msgid "A retained bullet was removed from head."
msgstr "Un proiettile ritenuto è stato rimosso dalla testa."

msgctxt "IAT_EM_BULLET_REMOVED_Torso"
msgid "Removed a retained bullet from torso."
msgstr "Rimosso un proiettile ritenuto dal tronco."

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_Torso"
msgid "A retained bullet was removed from torso."
msgstr "Un proiettile ritenuto è stato rimosso dal tronco."

msgctxt "IAT_EM_BULLET_REMOVED_LeftArm"
msgid "Removed a retained bullet from left arm."
msgstr "Rimosso un proiettile ritenuto dal braccio sinistro."

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_LeftArm"
msgid "A retained bullet was removed from left arm."
msgstr "Un proiettile ritenuto è stato rimosso dal braccio sinistro."

msgctxt "IAT_EM_BULLET_REMOVED_RightArm"
msgid "Removed a retained bullet from right arm."
msgstr "Rimosso un proiettile ritenuto dal braccio destro."

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_RightArm"
msgid "A retained bullet was removed from right arm."
msgstr "Un proiettile ritenuto è stato rimosso dal braccio destro."

msgctxt "IAT_EM_BULLET_REMOVED_RightHand"
msgid "Removed a retained bullet from right hand."
msgstr "Rimosso un proiettile ritenuto dalla mano destra."

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_RightHand"
msgid "A retained bullet was removed from right hand."
msgstr "Un proiettile ritenuto è stato rimosso dalla mano destra."

msgctxt "IAT_EM_BULLET_REMOVED_LeftHand"
msgid "Removed a retained bullet from left hand."
msgstr "Rimosso un proiettile ritenuto dalla mano sinistra."

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_LeftHand"
msgid "A retained bullet was removed from left hand."
msgstr "Un proiettile ritenuto è stato rimosso dalla mano sinistra."

msgctxt "IAT_EM_BULLET_REMOVED_LeftLeg"
msgid "Removed a retained bullet from left leg."
msgstr "Rimosso un proiettile ritenuto dalla gamba sinistra."

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_LeftLeg"
msgid "A retained bullet was removed from left leg."
msgstr "Un proiettile ritenuto è stato rimosso dalla gamba sinistra."

msgctxt "IAT_EM_BULLET_REMOVED_RightLeg"
msgid "Removed a retained bullet from right leg."
msgstr "Rimosso un proiettile ritenuto dalla gamba destra."

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_RightLeg"
msgid "A retained bullet was removed from right leg."
msgstr "Un proiettile ritenuto è stato rimosso dalla gamba destra."

msgctxt "IAT_EM_BULLET_REMOVED_LeftFoot"
msgid "Removed a retained bullet from left foot."
msgstr "Rimosso un proiettile ritenuto dal piede sinistro."

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_LeftFoot"
msgid "A retained bullet was removed from left foot."
msgstr "Un proiettile ritenuto è stato rimosso dal piede sinistro."

msgctxt "IAT_EM_BULLET_REMOVED_RightFoot"
msgid "Removed a retained bullet from right foot."
msgstr "Rimosso un proiettile ritenuto dal piede destro."

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_RightFoot"
msgid "A retained bullet was removed from right foot."
msgstr "Un proiettile ritenuto è stato rimosso dal piede destro."

