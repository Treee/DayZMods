msgctxt "IAT_EM_ACTION_EXTRACT_BULLET_SELF"
msgid "Extract bullet"
msgstr "弾丸を摘出する"

msgctxt "IAT_EM_ACTION_EXTRACT_BULLET_TARGET"
msgid "Extract person's bullet"
msgstr "他の人の弾丸を摘出する"

msgctxt "IAT_EM_ACTION_REMOVE_BANDAGE_SELF"
msgid "Cut off bandage"
msgstr "包帯を切り取る"

msgctxt "IAT_EM_ACTION_REMOVE_BANDAGE_TARGET"
msgid "Cut off person's bandage"
msgstr "他の人の包帯を切り取る"

msgctxt "IAT_EM_REMOVE_INCOMPATIBLE_DRESSING"
msgid "Remove the damaged or incompatible dressing before applying a new one."
msgstr "新しい被覆材を当てる前に、傷んだ、または適合しない被覆材を取り除いてください。"

msgctxt "IAT_EM_DRESSING_ATTACHMENT_FAILED"
msgid "The dressing could not be attached."
msgstr "被覆材を固定できませんでした。"

msgctxt "IAT_EM_BANDAGE_REMOVED"
msgid "Cut off a bandage."
msgstr "包帯を切り取りました。"

msgctxt "IAT_EM_PATIENT_BANDAGE_REMOVED"
msgid "Your bandage was cut off."
msgstr "あなたの包帯が切り取られました。"

msgctxt "IAT_EM_NO_RETAINED_BULLET"
msgid "No retained bullet was found."
msgstr "体内に残った弾丸は見つかりませんでした。"

msgctxt "IAT_EM_BULLET_REMOVED_Head"
msgid "Removed a retained bullet from head."
msgstr "頭部に残っていた弾丸を摘出しました。"

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_Head"
msgid "A retained bullet was removed from head."
msgstr "あなたの頭部に残っていた弾丸が摘出されました。"

msgctxt "IAT_EM_BULLET_REMOVED_Torso"
msgid "Removed a retained bullet from torso."
msgstr "胴体に残っていた弾丸を摘出しました。"

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_Torso"
msgid "A retained bullet was removed from torso."
msgstr "あなたの胴体に残っていた弾丸が摘出されました。"

msgctxt "IAT_EM_BULLET_REMOVED_LeftArm"
msgid "Removed a retained bullet from left arm."
msgstr "左腕に残っていた弾丸を摘出しました。"

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_LeftArm"
msgid "A retained bullet was removed from left arm."
msgstr "あなたの左腕に残っていた弾丸が摘出されました。"

msgctxt "IAT_EM_BULLET_REMOVED_RightArm"
msgid "Removed a retained bullet from right arm."
msgstr "右腕に残っていた弾丸を摘出しました。"

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_RightArm"
msgid "A retained bullet was removed from right arm."
msgstr "あなたの右腕に残っていた弾丸が摘出されました。"

msgctxt "IAT_EM_BULLET_REMOVED_RightHand"
msgid "Removed a retained bullet from right hand."
msgstr "右手に残っていた弾丸を摘出しました。"

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_RightHand"
msgid "A retained bullet was removed from right hand."
msgstr "あなたの右手に残っていた弾丸が摘出されました。"

msgctxt "IAT_EM_BULLET_REMOVED_LeftHand"
msgid "Removed a retained bullet from left hand."
msgstr "左手に残っていた弾丸を摘出しました。"

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_LeftHand"
msgid "A retained bullet was removed from left hand."
msgstr "あなたの左手に残っていた弾丸が摘出されました。"

msgctxt "IAT_EM_BULLET_REMOVED_LeftLeg"
