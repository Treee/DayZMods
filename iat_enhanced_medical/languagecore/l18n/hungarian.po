msgstr "A bent maradt lövedék eltávolítva a jobb lábból."

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_RightLeg"
msgid "A retained bullet was removed from right leg."
msgstr "Egy bent maradt lövedéket eltávolítottak a jobb lábból."

msgctxt "IAT_EM_BULLET_REMOVED_LeftFoot"
msgid "Removed a retained bullet from left foot."
msgstr "A bent maradt lövedék eltávolítva a bal lábfejből."

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_LeftFoot"
msgid "A retained bullet was removed from left foot."
msgstr "Egy bent maradt lövedéket eltávolítottak a bal lábfejből."

msgctxt "IAT_EM_BULLET_REMOVED_RightFoot"
msgid "Removed a retained bullet from right foot."
msgstr "A bent maradt lövedék eltávolítva a jobb lábfejből."

msgctxt "IAT_EM_PATIENT_BULLET_REMOVED_RightFoot"
